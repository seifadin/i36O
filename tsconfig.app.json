{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@i360/theme-loader": [
        "./hub/theme/site/theme-loader.js"
      ],
      "@i360/net": [
        "./hub/src/net.js"
      ],
      "@i360/storage": [
        "./hub/src/storage.js"
      ],
      "@i360/sites": [
        "./hub/src/sites.js"
      ],
      "@i360/dates": [
        "./hub/src/dates.js"
      ],
      "@i360/exegesis": [
        "./hub/src/exegesis.js"
      ],
      "@i360/platform": [
        "./hub/src/platform.js"
      ],
      "@i360/icons": [
        "./hub/src/icons.js"
      ],
      "@i360/components": [
        "./hub/src/components.js"
      ]
    },
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src"
  ]
}
